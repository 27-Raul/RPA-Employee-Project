      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>System.ComponentModel.TypeConverter</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Main Orchestrator Sequence" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)" Name="config" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)" Name="employeeData" />
      <Variable x:TypeArguments="x:Boolean" Name="isValid" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="validationErrors" />
      <Variable x:TypeArguments="x:String" Name="employeeID" />
      <Variable x:TypeArguments="x:String" Name="employeeFolder" />
      <Variable x:TypeArguments="x:Boolean" Name="folderSuccess" />
      <Variable x:TypeArguments="x:String" Name="welcomeLetterPath" />
      <Variable x:TypeArguments="x:Boolean" Name="letterSuccess" />
      <Variable x:TypeArguments="x:Boolean" Name="emailSuccess" />
      <Variable x:TypeArguments="x:String" Name="emailMode" />
      <Variable x:TypeArguments="x:Boolean" Name="dbSuccess" />
      <Variable x:TypeArguments="x:String" Name="reportPath" />
      <Variable x:TypeArguments="x:Boolean" Name="reportSuccess" />
      <Variable x:TypeArguments="x:String" Name="inputFilePath" />
      <Variable x:TypeArguments="x:Boolean" Name="inputFileExists" />
      <Variable x:TypeArguments="x:String" Name="jsonText" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:LogMessage DisplayName="Log Workflow Start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;============================================================&quot; + Environment.NewLine + &quot;  Starting UiPath Employee Onboarding Orchestrator&quot; + Environment.NewLine + &quot;============================================================&quot;]" />
    <TryCatch DisplayName="Try Onboarding Workflow" sap2010:WorkflowViewState.IdRef="TryCatch_1">
      <TryCatch.Try>
        <Sequence DisplayName="Execute Onboarding Pipeline" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke Initialize_Config" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Workflows\Initialize_Config.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_ConfigFile">..\Config.xlsx</InArgument>
              <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="out_Config">[config]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <Assign sap2010:WorkflowViewState.IdRef="Assign_1">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[inputFilePath]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">..\Input\New_Employee.json</InArgument>
            </Assign.Value>
          </Assign>
          <ui:FileExistsX DisplayName="Check New Employee Input" Exists="[inputFileExists]" sap2010:WorkflowViewState.IdRef="FileExistsX_1" Path="[inputFilePath]" />
          <If Condition="[Not inputFileExists]" DisplayName="Fallback to Sample Input" sap2010:WorkflowViewState.IdRef="If_1">
            <If.Then>
              <Assign sap2010:WorkflowViewState.IdRef="Assign_2">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:String">[inputFilePath]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:String">..\Input\Sample_Employee_01.json</InArgument>
                </Assign.Value>
              </Assign>
            </If.Then>
          </If>
          <ui:ReadTextFile File="{x:Null}" Content="[jsonText]" DisplayName="Read Input JSON" FileName="[inputFilePath]" sap2010:WorkflowViewState.IdRef="ReadTextFile_1" />
          <Assign DisplayName="Initialize Employee Data Dictionary" sap2010:WorkflowViewState.IdRef="Assign_3">
            <Assign.To>
              <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">[employeeData]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">[Newtonsoft.Json.JsonConvert.DeserializeObject(Of Dictionary(Of String, String))(jsonText)]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke Validate_Data" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_2" UnSafe="False" WorkflowFileName="Workflows\Validate_Data.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="in_EmployeeData">[employeeData]</InArgument>
              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_IsValid">[isValid]</OutArgument>
              <OutArgument x:TypeArguments="scg:List(x:String)" x:Key="out_Errors">[validationErrors]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <If Condition="[Not isValid]" DisplayName="If Data is Invalid" sap2010:WorkflowViewState.IdRef="If_2">
            <If.Then>
              <Throw DisplayName="Throw Validation Exception" Exception="[New BusinessRuleException(&quot;Validation failed: &quot; + String.Join(&quot;; &quot;, validationErrors))]" sap2010:WorkflowViewState.IdRef="Throw_1" />
            </If.Then>
          </If>
          <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke Generate_Employee_ID" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_3" UnSafe="False" WorkflowFileName="Workflows\Generate_Employee_ID.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_DatabasePath">..\Database\EmployeeDatabase.xlsx</InArgument>
              <OutArgument x:TypeArguments="x:String" x:Key="out_EmployeeID">[employeeID]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke Create_Employee_Folder" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_4" UnSafe="False" WorkflowFileName="Workflows\Create_Employee_Folder.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_EmployeeRootFolder">..\Employees</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_EmployeeID">[employeeID]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_FullName">[employeeData("full_name")]</InArgument>
              <OutArgument x:TypeArguments="x:String" x:Key="out_EmployeeFolderPath">[employeeFolder]</OutArgument>
              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Success">[folderSuccess]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke Generate_Welcome_Letter" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_5" UnSafe="False" WorkflowFileName="Workflows\Generate_Welcome_Letter.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="in_EmployeeData">[employeeData]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_EmployeeID">[employeeID]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_EmployeeFolder">[employeeFolder]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_CompanyName">[config("CompanyName")]</InArgument>
              <OutArgument x:TypeArguments="x:String" x:Key="out_WelcomeLetterPath">[welcomeLetterPath]</OutArgument>
              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Success">[letterSuccess]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke Send_Email" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_6" UnSafe="False" WorkflowFileName="Workflows\Send_Email.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="in_Config">[config]</InArgument>
              <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="in_EmployeeData">[employeeData]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_EmployeeID">[employeeID]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_AttachmentPath">[welcomeLetterPath]</InArgument>
              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Success">[emailSuccess]</OutArgument>
              <OutArgument x:TypeArguments="x:String" x:Key="out_EmailMode">[emailMode]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke Update_Excel_Database" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_7" UnSafe="False" WorkflowFileName="Workflows\Update_Excel_Database.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_DatabasePath">..\Database\EmployeeDatabase.xlsx</InArgument>
              <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="in_EmployeeData">[employeeData]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_EmployeeID">[employeeID]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_EmployeeFolder">[employeeFolder]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_WelcomeLetterPath">[welcomeLetterPath]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_EmailStatus">[If(emailSuccess, "Sent", "Failed")]</InArgument>
              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Success">[dbSuccess]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke Generate_Report" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_8" UnSafe="False" WorkflowFileName="Workflows\Generate_Report.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_DatabasePath">..\Database\EmployeeDatabase.xlsx</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_ReportFolderPath">..\Reports</InArgument>
              <OutArgument x:TypeArguments="x:String" x:Key="out_ReportPath">[reportPath]</OutArgument>
              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Success">[reportSuccess]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:LogMessage DisplayName="Log Success" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[&quot;Onboarding successfully completed for &quot; + employeeID + &quot; (&quot; + employeeData(&quot;full_name&quot;) + &quot;)&quot;]" />
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch`1_1">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="ex" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Handle Global Error" sap2010:WorkflowViewState.IdRef="Sequence_3">
              <ui:LogMessage DisplayName="Log Exception" sap2010:WorkflowViewState.IdRef="LogMessage_3" Level="Error" Message="[&quot;UiPath Workflow Exception: &quot; + ex.Message]" />
            </Sequence>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>
  </Sequence>
</Activity>