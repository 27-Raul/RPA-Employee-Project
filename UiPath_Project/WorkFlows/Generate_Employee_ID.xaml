<Activity mc:Ignorable="sap sap2010" x:Class="Generate_Employee_ID" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_DatabasePath" Type="InArgument(x:String)" />
    <x:Property Name="out_EmployeeID" Type="OutArgument(x:String)" />
  </x:Members>
  <VisualBasic.Settings>
    <x:Null />
  </VisualBasic.Settings>
  <sap2010:WorkflowViewState.IdRef>Generate_Employee_ID_1</sap2010:WorkflowViewState.IdRef>
  <TextExpression.NamespacesForImplementation>
    <scg:List x:TypeArguments="x:String" Capacity="34">
      <x:String>GlobalConstantsNamespace</x:String>
      <x:String>GlobalVariablesNamespace</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>UiPath.Excel</x:String>
      <x:String>UiPath.Excel.Activities</x:String>
    </scg:List>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <scg:List x:TypeArguments="AssemblyReference" Capacity="34">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic.Core</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Generate_Employee_ID" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Boolean" Name="dbExists" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtEmployees" />
      <Variable x:TypeArguments="x:Int32" Default="0" Name="maxIdNum" />
    </Sequence.Variables>
    <Assign DisplayName="Default Fallback ID" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To><OutArgument x:TypeArguments="x:String">[out_EmployeeID]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">["EMP001"]</InArgument></Assign.Value>
    </Assign>
    <ui:FileExistsX DisplayName="Check DB Exists" Exists="[dbExists]" Path="[in_DatabasePath]" sap2010:WorkflowViewState.IdRef="FileExistsX_1" />
    <If Condition="[dbExists]" DisplayName="If Database Exists" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Read Existing IDs" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <ui:ReadRange Range="" AddHeaders="True" DataTable="[dtEmployees]" DisplayName="Read Database Range" SheetName="Employees" WorkbookPath="[in_DatabasePath]" sap2010:WorkflowViewState.IdRef="ReadRange_1" />
          <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[dtEmployees]" DisplayName="For Each Employee Row" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
            <ui:ForEachRow.Body>
              <ActivityAction x:TypeArguments="sd:DataRow">
                <ActivityAction.Argument>
                  <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
                </ActivityAction.Argument>
                <Sequence DisplayName="Parse ID" sap2010:WorkflowViewState.IdRef="Sequence_3">
                  <Sequence.Variables>
                    <Variable x:TypeArguments="x:String" Name="rawId" />
                    <Variable x:TypeArguments="x:Int32" Name="currentNum" />
                  </Sequence.Variables>
                  <Assign sap2010:WorkflowViewState.IdRef="Assign_2">
                    <Assign.To><OutArgument x:TypeArguments="x:String">[rawId]</OutArgument></Assign.To>
                    <Assign.Value><InArgument x:TypeArguments="x:String">[If(row("Employee ID") IsNot Nothing, row("Employee ID").ToString().Trim(), "")]</InArgument></Assign.Value>
                  </Assign>
                  <If Condition="[rawId.StartsWith(&quot;EMP&quot;) AndAlso Integer.TryParse(rawId.Substring(3), currentNum)]" DisplayName="If Valid EMP Format" sap2010:WorkflowViewState.IdRef="If_2">
                    <If.Then>
                      <If Condition="[currentNum &gt; maxIdNum]" DisplayName="Check If Greater" sap2010:WorkflowViewState.IdRef="If_3">
                        <If.Then>
                          <Assign sap2010:WorkflowViewState.IdRef="Assign_3">
                            <Assign.To><OutArgument x:TypeArguments="x:Int32">[maxIdNum]</OutArgument></Assign.To>
                            <Assign.Value><InArgument x:TypeArguments="x:Int32">[currentNum]</InArgument></Assign.Value>
                          </Assign>
                        </If.Then>
                      </If>
                    </If.Then>
                  </If>
                </Sequence>
              </ActivityAction>
            </ui:ForEachRow.Body>
          </ui:ForEachRow>
          <Assign DisplayName="Generate Next ID" sap2010:WorkflowViewState.IdRef="Assign_4">
            <Assign.To><OutArgument x:TypeArguments="x:String">[out_EmployeeID]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">["EMP" + (maxIdNum + 1).ToString("D3")]</InArgument></Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
    </If>
    <ui:LogMessage DisplayName="Log Generated ID" Level="Info" Message="[&quot;Generated Employee ID: &quot; + out_EmployeeID]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
  </Sequence>
</Activity>
